# Copy this file to deploy/deploy.env and fill it in. deploy.env is git-ignored.
# Then deploy with:  npm run deploy

# SSH login for the server (the user needs sudo there)
DEPLOY_HOST=ubuntu@203.0.113.10
DEPLOY_PORT=22
# DEPLOY_SSH_KEY=C:/Users/you/.ssh/id_ed25519

# Where the game is served. The build is made for this path automatically.
URL_PATH=/treasure_hunt

# Where releases are kept on the server
APP_DIR=/var/www/treasure_hunt

# When the server has several sites: the domain or IP address the kiosks open the game at.
# The installer finds the nginx file and server block whose server_name lists it.
NGINX_SERVER_NAME=

# nginx file that holds that server block. Leave empty to find it automatically (by
# NGINX_SERVER_NAME, or the only site there is). Example: /etc/nginx/conf.d/default.conf
NGINX_SITE=

# How many old releases to keep for rollback
KEEP_RELEASES=5

# How long a kiosk stays logged in after entering the admin ID/password
COOKIE_DAYS=365

# Mark the login cookie Secure: auto (when the site listens on 443), yes, or no
COOKIE_SECURE=auto

# Printed at the end of a deploy, e.g. https://chips.cg.gov.in
PUBLIC_URL=

# The select-game screen that opens this game. Players get an "All games" button back to it,
# and an idle kiosk returns there after 2 minutes. Leave empty if there is no launcher yet.
LAUNCHER_URL=

# Rajyotsav certificate API that the kiosk browser posts each win to
CERT_API_URL=https://cggeomap.cgstate.gov.in/rajyotsav/api/certificate

# Server reports (deploy/server/report.sh, run on the server) go to this branch of the repository.
# Pushing needs the server's deploy key to have write access. See deploy/README.md.
REPORT_BRANCH=server-reports
# Or push them to a separate repository's main branch, with its own write key:
# REPORT_REPO=git@github.com:CMITF/treasure_hunt_reports.git
# REPORT_SSH_KEY=~/.ssh/treasure_hunt_reports
